// SiteCheck website snapshot while audits have no host (kit: ~/Desktop/projects/site-holding-kit).
{
  "name": "sitecheck-holding",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./site", "binding": "ASSETS", "run_worker_first": true, "html_handling": "drop-trailing-slash" },
  "kv_namespaces": [{ "binding": "WAITLIST", "id": "68baef21b4a342fab588a1076d5d1dde" }],
  "vars": {
    "BANNER": "We're having some deployment issues while we move off our free hosting plan — audits are paused.",
    "APP_PATHS": "/results"
  },
  "workers_dev": true
}
